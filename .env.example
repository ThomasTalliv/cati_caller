# ── Database ──────────────────────────────────────────────────────────────────
DB__POSTGRES_URL=postgresql+asyncpg://cati:cati@localhost:5432/cati
DB__REDIS_URL=redis://localhost:6379/0
DB__POOL_SIZE=10
DB__ECHO_SQL=false

# ── SignalWire ─────────────────────────────────────────────────────────────────
SIGNALWIRE__PROJECT_ID=your-project-id
SIGNALWIRE__API_TOKEN=your-api-token
SIGNALWIRE__SPACE_URL=your-space.signalwire.com
SIGNALWIRE__OUTBOUND_NUMBER=+15551234567
SIGNALWIRE__WEBHOOK_BASE_URL=https://your-public-host.example.com

# ── TTS ───────────────────────────────────────────────────────────────────────
TTS__PROVIDER=kokoro                    # kokoro | xtts
TTS__KOKORO_MODEL=kokoro-v1.0
TTS__KOKORO_VOICE=af_sky
TTS__KOKORO_DEVICE=cpu                  # cuda | cpu
TTS__XTTS_MODEL_PATH=/models/xtts-v2
TTS__VOICE_SAMPLE_PATH=                 # path to WAV for XTTS voice cloning

# ── STT ───────────────────────────────────────────────────────────────────────
STT__PROVIDER=faster_whisper
STT__MODEL_SIZE=large-v3-turbo
STT__DEVICE=cpu                         # cuda | cpu
STT__COMPUTE_TYPE=float32               # float16 (GPU) | float32 (CPU) | int8
STT__LANGUAGE=en
STT__VAD_ENABLED=true
STT__VAD_THRESHOLD=0.5

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM__PRIMARY_PROVIDER=anthropic         # anthropic | openai
LLM__ANTHROPIC_API_KEY=sk-ant-...
LLM__ANTHROPIC_MODEL=claude-sonnet-4-6
LLM__OPENAI_API_KEY=sk-...
LLM__OPENAI_MODEL=gpt-4o
LLM__MAX_TOKENS=4096
LLM__TEMPERATURE=0.3
# Cost optimisation: cheap model for live parsing, Sonnet only for analysis.
# Leave empty to use the primary model for both.
LLM__PARSING_MODEL=                     # e.g. claude-haiku-4-5-20251001 or gpt-4o-mini
LLM__PARSING_MAX_TOKENS=256

# ── Export ────────────────────────────────────────────────────────────────────
EXPORT__EXPORT_DIR=/data/exports
EXPORT__GOOGLE_SERVICE_ACCOUNT_JSON=    # path to service-account.json
EXPORT__GOOGLE_SHEETS_FOLDER_ID=        # Google Drive folder ID

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY__BROKER_URL=redis://localhost:6379/1
CELERY__RESULT_BACKEND=redis://localhost:6379/2
CELERY__CALL_CONCURRENCY=5
CELERY__WORKER_CONCURRENCY=4

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
API_KEY=change-me-in-production
